# ============================================================
# PAIOS — Personal AI Operating System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM Configuration ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Fallback (Optional but recommended)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...

# ── Weather ────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key_here
WEATHER_CITY=Bengaluru
WEATHER_COUNTRY=IN

# ── Financial Data ─────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_key_here
FINNHUB_API_KEY=your_key_here
COINGECKO_API_KEY=your_key_here   # Free tier available

# ── News APIs ──────────────────────────────────────────────
NEWS_API_KEY=your_key_here         # newsapi.org — free tier
GNEWS_API_KEY=your_key_here        # gnews.io — free tier

# ── Google APIs (Calendar, Gmail) ─────────────────────────
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_ID=primary

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://paios:paios@localhost:5432/paios
REDIS_URL=redis://localhost:6379/0

# ── Dashboard ──────────────────────────────────────────────
DASHBOARD_REFRESH_INTERVAL=300    # seconds (5 min)
DASHBOARD_PORT=8501

# ── Notification ───────────────────────────────────────────
ENABLE_DESKTOP_NOTIFICATIONS=true
ENABLE_SOUND_ALERTS=true

# ── User Profile ───────────────────────────────────────────
USER_NAME=Subramanya
USER_LOCATION=Bengaluru, India
USER_TIMEZONE=Asia/Kolkata

# ── Portfolio (Optional) ───────────────────────────────────
ZERODHA_API_KEY=
ZERODHA_SECRET=
